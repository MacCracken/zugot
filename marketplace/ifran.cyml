# ifran — the AGNOS training control plane
# Runs and records training jobs, keeps a signed checkpoint store, curates
# datasets, runs sweeps (with per-combo evals) and evals, and holds preference
# data. It orchestrates; the sovereign ML siblings (attn11, tarka, tentib,
# prajna, anukūlana) own the math.
#
# Name: ifran (عرفان — gnosis)
# CLI: ifran run job.cyml · ifran sweep sweep.cyml · ifran store add ckpt.tula
# Lang: Cyrius (was Rust through 1.x; 2.x is the Cyrius port). One static
#       binary. For the build-from-source system package, see ai/ifran.cyml.
#
# Status: Released — v2.5.0.

[package]
name = "ifran"
version = "2.5.0"
description = "ifran — the AGNOS training control plane (jobs, signed checkpoint store, datasets, sweeps, evals)"
license = "GPL-3.0-only"
groups = ["tool", "ai", "ml", "cyrius"]
release = 1
arch = "x86_64"

[source]
github_release = "MacCracken/ifran"
release_asset = "ifran"
# The build/ifran line of the release's SHA256SUMS (the static x86_64 binary)
sha256 = "50498793a7d52c6026e30b3791cb387ebfd1936b33039854603439f6093c4b54"

[depends]
runtime = []
build = []

[marketplace]
category = "ai-platform"
runtime = "native-binary"
publisher = "AGNOS"
tags = ["training", "ml", "ai", "jobs", "sweeps", "evals", "checkpoints", "cyrius"]
min_agnos_version = "2026.3.24"

[marketplace.sandbox]
seccomp_mode = "basic"
network_access = false

[build]
make = ""
check = ""
install = '''
install -Dm755 ifran $PKG/usr/bin/ifran
'''

[security]
hardening = ["pie", "fullrelro", "fortify", "stackprotector", "bindnow"]
