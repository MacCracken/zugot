# Agnostic — QA agent platform for the AGNOS marketplace
# Crews, QA tools, reports and a WebGUI over AgnosAI. One static binary, with its
# database and tamper-evident audit trail embedded; TLS belongs to a reverse proxy.
#
# Bin: agnostic
# Lang: Cyrius (was Python/CrewAI in a container through 2026.3.18; 0.x is the
# port, and the version line restarts with it)
#
# Status: Released — v0.3.0. Deployment guide: docs/guides/deployment.md upstream.

[package]
name = "agnostic"
version = "0.3.0"
description = "Agnostic — QA agent platform: crews, QA tools, reports and a WebGUI over AgnosAI"
license = "GPL-3.0-only"
groups = ["server", "agent-automation", "ai-agents", "cyrius"]
release = 1
arch = "x86_64"

[source]
github_release = "MacCracken/agnostic"
release_asset = "agnostic"
sha256 = "57a6d15f2a1b6128b4da272fa6fc88e333dfe14a83a8b553ef226b0df630d39c"

[depends]
# A static binary: `file` reads "statically linked", and `ldd` finds nothing to load.
runtime = []
build = []

[marketplace]
category = "developer-tools"
runtime = "native-binary"
publisher = "Agnostic"
tags = ["agent-automation", "ai-agents", "crew-orchestration", "qa", "testing", "security-compliance", "cyrius"]
min_agnos_version = "2026.3.17"

[marketplace.sandbox]
seccomp_mode = "basic"
network_access = true
allowed_hosts = [
    "localhost",
    "127.0.0.1",
    # LLM Gateway (hoosh). agnostic reaches no provider directly.
]
data_dir = "/var/lib/agnostic/"

[[marketplace.sandbox.landlock]]
path = "/var/lib/agnostic/"
access = "rw"

[marketplace.services]
# The API and the WebGUI, at /ui. Plain HTTP, on loopback unless AGNOSTIC_ADDR says otherwise.
ports = [8000]
# Optional at run time: with no gateway, crews run and say they are placeholders.
depends_on = ["llm-gateway"]

[build]
make = ""
check = ""
install = '''
install -Dm755 agnostic $PKG/usr/bin/agnostic
mkdir -p $PKG/var/lib/agnostic
mkdir -p $PKG/etc/agnostic

# Desktop entry for aethersafha (opens the WebGUI in a browser)
mkdir -p $PKG/usr/share/applications
cat > $PKG/usr/share/applications/agnostic.desktop << 'EOF'
[Desktop Entry]
Name=Agnostic
Comment=QA agent platform
GenericName=Agent Automation
Exec=xdg-open http://localhost:8000/ui
Icon=agnostic
Terminal=false
Type=Application
Categories=Development;Testing;
StartupNotify=true
EOF
'''

[security]
hardening = ["pie", "fullrelro", "fortify", "stackprotector", "bindnow"]
